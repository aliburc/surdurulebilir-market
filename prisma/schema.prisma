generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUPPLIER
}

enum RequestType {
  QUOTE
  SAMPLE
}

enum RequestStatus {
  PENDING
  RESPONDED
  ACCEPTED
  DECLINED
}

enum OrderStatus {
  AWAITING_PAYMENT
  ESCROW_HELD
  PARTIALLY_RELEASED
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum PaymentEventType {
  CAPTURE
  PARTIAL_RELEASE
  FINAL_RELEASE
  REFUND
}

enum PaymentEventStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED_BUYER
  RESOLVED_SUPPLIER
  RESOLVED_SPLIT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  buyer        Buyer?
  supplier     Supplier?
  disputesRaised Dispute[]
}

model Supplier {
  id                  String          @id @default(cuid())
  userId              String          @unique
  user                User            @relation(fields: [userId], references: [id])
  companyName         String
  slug                String          @unique
  city                String
  region              String
  foundedYear         Int?
  description         String @db.Text
  logoInitials        String
  logoColor           String
  sustainabilityScore Int
  contactName         String
  contactEmail        String
  catalogItems        CatalogItem[]
  certifications      SupplierCertification[]
  materialComponents  MaterialComponent[]
  orders              Order[]
}

model Buyer {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id])
  companyName  String
  sector       String
  city         String
  contactName  String
  contactEmail String
  requests     QuoteRequest[]
  orders       Order[]
}

model CatalogItem {
  id                     String          @id @default(cuid())
  supplierId             String
  supplier               Supplier        @relation(fields: [supplierId], references: [id])
  name                   String
  sku                    String          @unique
  slug                   String          @unique
  category               String
  material               String
  recycledContentPercent Int?
  weightGrams            Int?
  dimensions             String
  minOrderQuantity       Int
  unitPriceMinTRY        Float?
  unitPriceMaxTRY        Float?
  leadTimeDays           Int
  imageColor             String
  sustainabilityTags     String
  description            String              @db.Text
  recyclabilityGrade     String?
  carbonFootprintGramsCO2e Int?
  lastVerifiedAt         DateTime?
  status                 String          @default("active")
  requests               QuoteRequest[]
  certifications         ItemCertification[]
  components             CatalogItemComponent[]
  orders                 Order[]
}

model MaterialComponent {
  id             String                    @id @default(cuid())
  supplierId     String
  supplier       Supplier                  @relation(fields: [supplierId], references: [id])
  name           String
  spec           String
  recyclability  String
  sourceType     String
  catalogItems   CatalogItemComponent[]
}

model CatalogItemComponent {
  catalogItemId       String
  catalogItem         CatalogItem       @relation(fields: [catalogItemId], references: [id])
  materialComponentId String
  materialComponent   MaterialComponent @relation(fields: [materialComponentId], references: [id])
  role                String

  @@id([catalogItemId, materialComponentId])
}

model Certification {
  id           String                  @id @default(cuid())
  name         String                  @unique
  issuingBody  String
  description  String                  @db.Text
  suppliers    SupplierCertification[]
  catalogItems ItemCertification[]
}

model SupplierCertification {
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id])

  @@id([supplierId, certificationId])
}

model ItemCertification {
  catalogItemId   String
  catalogItem     CatalogItem   @relation(fields: [catalogItemId], references: [id])
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id])

  @@id([catalogItemId, certificationId])
}

model QuoteRequest {
  id            String        @id @default(cuid())
  buyerId       String
  buyer         Buyer         @relation(fields: [buyerId], references: [id])
  catalogItemId String
  catalogItem   CatalogItem   @relation(fields: [catalogItemId], references: [id])
  type          RequestType
  quantity      Int
  message       String?       @db.Text
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  order         Order?
}

model Testimonial {
  id          String @id @default(cuid())
  authorName  String
  authorTitle String
  companyName String
  quote       String @db.Text
}

model CaseStudy {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  summary     String @db.Text
  body        String @db.Text
  metricLabel String
  metricValue String
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String @db.Text
  body        String @db.Text
  category    String
  publishedAt DateTime @default(now())
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  order    Int    @default(0)
}

/// Represents a committed transaction once a buyer decides to proceed with an
/// accepted quote. No real payment provider is wired up yet — this model
/// exists so the escrow/release lifecycle can be built and tested against
/// real data before a provider (e.g. iyzico Pazaryeri) is integrated.
model Order {
  id                     String        @id @default(cuid())
  quoteRequestId         String        @unique
  quoteRequest           QuoteRequest  @relation(fields: [quoteRequestId], references: [id])
  buyerId                String
  buyer                  Buyer         @relation(fields: [buyerId], references: [id])
  supplierId             String
  supplier               Supplier      @relation(fields: [supplierId], references: [id])
  catalogItemId          String
  catalogItem            CatalogItem   @relation(fields: [catalogItemId], references: [id])
  quantity               Int
  unitPriceTRY           Float
  totalAmountTRY         Float
  platformFeeTRY         Float?
  releasedAmountTRY      Float         @default(0)
  status                 OrderStatus   @default(AWAITING_PAYMENT)
  paidAt                 DateTime?
  productionConfirmedAt  DateTime?
  deliveryConfirmedAt    DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  payments               PaymentEvent[]
  disputes               Dispute[]
}

/// A single money-movement event within an order's escrow lifecycle
/// (capture, partial release, final release, refund). `provider` and
/// `providerReferenceId` stay null until a real payment provider is
/// connected; until then these rows document intended events for the
/// order-status UI without moving any real money.
model PaymentEvent {
  id                  String              @id @default(cuid())
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id])
  type                PaymentEventType
  amountTRY           Float
  status              PaymentEventStatus  @default(PENDING)
  provider            String?
  providerReferenceId String?
  note                String?             @db.Text
  createdAt           DateTime            @default(now())
}

model Dispute {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  raisedByUserId String
  raisedByUser   User          @relation(fields: [raisedByUserId], references: [id])
  reason         String        @db.Text
  status         DisputeStatus @default(OPEN)
  resolutionNote String?       @db.Text
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
}
